import camion.*
import cosas.*
describe "las pruebas del camion" {
    test "carga funciona como deberia?" {
        camion.cargar(paqueteLadrillos)
        camion.cargar(bateriaAntiaerea)
        assert.equals(#{paqueteLadrillos , bateriaAntiaerea} , camion.cosas())
        assert.equals(2 , camion.cosas().size())
        camion.cargar(paqueteLadrillos)
        assert.equals(2 , camion.cosas().size())
    }
}