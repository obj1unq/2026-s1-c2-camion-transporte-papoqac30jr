import camion.*
import cosas.*
describe "las pruebas del camion" {
    test "carga funciona como deberia?" {
        camion.cargar(paqueteLadrillos)
        camion.cargar(bateriaAntiaérea)
        assert.equals(1 , camion.cosas().size())
        assert.equals(#{paqueteLadrillos} , camion.cosas())
        camion.descargar(paqueteLadrillos)
        camion.cargar(bateriaAntiaérea)
        assert.equals(1 , camion.cosas().size())
        assert.equals(#{bateriaAntiaérea} , camion.cosas())
    }
}